{
  "name": "finch-assets",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm run tailwind:build && npm run vue:build",
    "watch": "concurrently -n tw,vite -c green,cyan --kill-others-on-fail \"npm run tailwind:watch\" \"npm run vue:watch\"",
    "tailwind:build": "tailwindcss -c tailwind.config.js -i ./public/assets/tailwind.input.css -o ./public/assets/generated-tailwind.css --minify",
    "tailwind:watch": "tailwindcss -c tailwind.config.js -i ./public/assets/tailwind.input.css -o ./public/assets/generated-tailwind.css --watch --poll",
    "vue:build": "vite build",
    "vue:watch": "vite build --watch"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.41",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.18",
    "vite": "^5.4.19"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@vueuse/core": "^14.3.0",
    "emoji-mart": "^5.6.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  }
}
